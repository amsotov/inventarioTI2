# Servidor únicamente. Sin valores de ejemplo utilizables ni cuentas por defecto.
APP_ORIGIN=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
AUTH_ENCRYPTION_KEY=
PORT=3000
# Loopback predeterminado. 0.0.0.0 solo detrás de ingress privado/TLS aprobado.
HOST=127.0.0.1
# DATABASE_URL debe autenticar exactamente como inventario_auth, sin propiedad/membresías.
# Pool empresarial separado: identidad exacta inventario_runtime, sin propiedad/membresías.
BUSINESS_DATABASE_URL=
# Worker empresarial separado. Deshabilitado; no arrancarlo sobre pendientes reales sin autorización.
# NOTIFICATION_DATABASE_URL: identidad exacta inventario_worker, sin propiedad/membresías.
NOTIFICATION_DATABASE_URL=
NOTIFICATION_DELIVERY_ENABLED=false
RESEND_API_KEY=
NOTIFICATION_FROM=

# Motor de inventario actual. sqlserver2016 bloquea inicio hasta modelo/soporte/instancia validados.
INVENTORY_BACKEND=postgres

# Opt-in exclusivo del laboratorio conectado; vacío conserva el servidor anterior.
APP_ENV=
MODERNIZATION_BACKEND=
SUPABASE_PROJECT_REF=
DB_SSL_CA_FILE=
