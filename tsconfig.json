{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": [
    "tests/auth/**/*.ts",
    "tests/security/**/*.ts",
    "tests/api/**/*.ts",
    "apps/server/**/*.ts",
    "apps/server/**/*.mjs",
    "tests/ui/**/*.ts",
    "tests/qa/**/*.ts",
    "tests/ops/**/*.ts",
    "ops/**/*.ts"
  ]
}
