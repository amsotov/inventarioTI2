{
  "openapi": "3.1.0",
  "info": {
    "title": "inventarioTI2 — API implementada en Fase 7",
    "version": "0.7.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-inventario"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "CommandResult": {
        "type": "object",
        "required": [
          "ref",
          "version",
          "aviso"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "aviso": {
            "const": "pendiente"
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "items",
          "nextCursor",
          "generatedAt",
          "timezone",
          "dateField"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "timezone": {
            "const": "UTC"
          },
          "dateField": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/bienes": {
      "get": {
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta autorizada; UTC, lista paginada o ficha",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
